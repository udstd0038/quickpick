{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickPick",
  "version": "0.1.0",
  "identifier": "com.quickpick.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter quickpick-desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter quickpick-desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickPick 设置",
        "width": 480,
        "height": 600,
        "minWidth": 480,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
