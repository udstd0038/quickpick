{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickPick",
  "version": "0.1.0",
  "identifier": "com.quickpick.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter quickpick-desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter quickpick-desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickPick 设置",
        "width": 480,
        "height": 600,
        "minWidth": 480,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' http://127.0.0.1:1420; script-src 'self' 'unsafe-inline' http://127.0.0.1:1420; style-src 'self' 'unsafe-inline' http://127.0.0.1:1420; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "installer/LICENSE.txt",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/shortcuts.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/installer-header.bmp",
        "sidebarImage": "installer/installer-sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Korean",
          "Japanese",
          "French",
          "German",
          "Spanish"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
